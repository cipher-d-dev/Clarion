generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  LECTURER
  ADMIN_STAFF
  DEPT_HEAD
  INSTITUTION_MGMT
  SUPER_ADMIN
}

enum ComplaintStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  AWAITING_INFORMATION
  ESCALATED
  RESOLVED
  CLOSED
  REJECTED
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_INFO
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

enum NotificationType {
  COMPLAINT_UPDATE
  TICKET_ASSIGNED
  ESCALATION
  SYSTEM
  ANNOUNCEMENT
}

enum EscalationLevel {
  DEPARTMENT
  INSTITUTION
  EXTERNAL
}

// ─── Tenant Core ─────────────────────────────────────────────────────────────

model Institution {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  domain    String?
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campuses         Campus[]
  departments      Department[]
  users            User[]
  complaints       Complaint[]
  tickets          Ticket[]
  knowledgeArticles KnowledgeArticle[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  chatMessages     ChatMessage[]

  @@index([slug])
  @@index([deletedAt])
}

model Campus {
  id            String    @id @default(cuid())
  institutionId String
  name          String
  code          String
  address       String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments Department[]
  users       User[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, deletedAt])
}

model Department {
  id            String    @id @default(cuid())
  institutionId String
  campusId      String?
  name          String
  code          String
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus      Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  users       User[]
  complaints  Complaint[]
  tickets     Ticket[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, campusId])
  @@index([institutionId, deletedAt])
}

model User {
  id            String    @id @default(cuid())
  institutionId String?
  campusId      String?
  departmentId  String?
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole
  matricNo      String?
  staffId       String?
  phone         String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  institution  Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  campus       Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  complaints   Complaint[]   @relation("ComplaintSubmitter")
  assignedTickets Ticket[]   @relation("TicketAssignee")
  ticketAssignments TicketAssignment[]
  internalNotes InternalNote[]
  notifications Notification[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  escalations  Escalation[]  @relation("EscalationInitiator")
  chatMessages ChatMessage[]

  @@index([institutionId])
  @@index([institutionId, role])
  @@index([institutionId, departmentId])
  @@index([email])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Complaints & Tickets ────────────────────────────────────────────────────

model Complaint {
  id            String          @id @default(cuid())
  institutionId String
  departmentId  String?
  submitterId   String
  referenceNumber String?
  title         String
  description   String
  status        ComplaintStatus @default(DRAFT)
  category      String?
  isAnonymous   Boolean         @default(false)
  sentimentScore  Float?
  aiMetadata      Json?
  satisfactionRating Int?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  institution Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department  Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  submitter   User                  @relation("ComplaintSubmitter", fields: [submitterId], references: [id])
  ticket      Ticket?
  attachments ComplaintAttachment[]
  timeline    TimelineEvent[]

  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, departmentId])
  @@index([institutionId, submitterId])
  @@index([institutionId, referenceNumber])
  @@index([institutionId, deletedAt])
}

model Ticket {
  id            String         @id @default(cuid())
  institutionId String
  departmentId  String?
  complaintId   String         @unique
  assigneeId    String?
  referenceNumber String?
  title         String
  description   String?
  priority      TicketPriority @default(MEDIUM)
  severity      TicketSeverity @default(MODERATE)
  status        TicketStatus   @default(OPEN)
  slaDeadline   DateTime?
  slaBreached   Boolean        @default(false)
  escalatedLevel Int           @default(0)
  dueAt         DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  institution  Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  complaint    Complaint          @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  assignee     User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignments  TicketAssignment[]
  escalations  Escalation[]
  internalNotes InternalNote[]
  timeline     TimelineEvent[]

  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, priority])
  @@index([institutionId, assigneeId])
  @@index([institutionId, deletedAt])
}

model TicketAssignment {
  id         String   @id @default(cuid())
  ticketId   String
  assigneeId String
  assignedBy String?
  note       String?
  createdAt  DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee User   @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([assigneeId])
}

model Escalation {
  id          String          @id @default(cuid())
  ticketId    String
  initiatorId String
  level       EscalationLevel
  reason      String
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  initiator User   @relation("EscalationInitiator", fields: [initiatorId], references: [id])

  @@index([ticketId])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  complaintId String?
  ticketId    String?
  actorId     String?
  eventType   String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  ticket    Ticket?    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([ticketId])
  @@index([createdAt])
}

model ComplaintAttachment {
  id          String   @id @default(cuid())
  complaintId String
  fileName    String
  fileUrl     String
  mimeType    String
  fileSize    Int
  uploadedAt  DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model InternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ─── Knowledge & Notifications ─────────────────────────────────────────────

model KnowledgeArticle {
  id            String    @id @default(cuid())
  institutionId String
  title         String
  slug          String
  content       String
  category      String?
  isPublished   Boolean   @default(false)
  viewCount     Int       @default(0)
  embedding     String?   @db.Text  // JSON-serialized float array (pgvector via raw SQL)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, slug])
  @@index([institutionId])
  @@index([institutionId, isPublished])
  @@index([institutionId, deletedAt])
}

model ChatMessage {
  id            String   @id @default(cuid())
  institutionId String
  userId        String
  role          String   // "user" | "assistant"
  content       String
  metadata      Json?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId, userId, createdAt])
}

model Notification {
  id            String           @id @default(cuid())
  institutionId String
  userId        String
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  metadata      Json?
  createdAt     DateTime         @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([institutionId, userId])
  @@index([userId, isRead])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String?
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  actor       User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([institutionId, entityType])
  @@index([actorId])
  @@index([createdAt])
}
