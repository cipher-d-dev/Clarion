# Server
PORT=4000
NODE_ENV=development

# Database (Supabase-compatible PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clarion?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret-in-production-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret-in-production-min-32"

# CORS
CORS_ORIGIN="http://localhost:3000"
